{
  "name": "nexor-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "tsc -b && react-router build",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "optimize:images": "node scripts/optimize-public-images.mjs",
    "verify:images": "node scripts/check-optimized-images.mjs",
    "prepush": "npm run verify:images && npm run typecheck && npm run test:run && npm run build",
    "preview": "vite preview --outDir build/client",
    "verify:ssg": "node scripts/verify-ssg.mjs",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e:onboarding-tab": "node scripts/pw-onboarding-tab-persistence.mjs",
    "test:e2e:lgpd:roles": "node scripts/lgpd-role-e2e-readiness.mjs",
    "qa:visual:admin-mobile": "node scripts/visual-qa-admin-mobile.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@react-router/node": "^7.18.4",
    "@supabase/supabase-js": "2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^11.18.2",
    "isbot": "^5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.1",
    "styled-components": "^6.1.13",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-router/dev": "^7.18.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-styled-components": "^2.3.0",
    "jsdom": "^29.1.1",
    "miragejs": "^0.1.48",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
