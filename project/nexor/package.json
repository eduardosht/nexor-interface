{
  "name": "nexor-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "optimize:images": "node scripts/optimize-public-images.mjs",
    "verify:images": "node scripts/check-optimized-images.mjs",
    "prepush": "npm run verify:images && npm run typecheck && npm run test:run && npm run build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "2.104.0",
    "@tanstack/react-query": "^5.100.14",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "styled-components": "^6.1.13",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "miragejs": "^0.1.48",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.6"
  }
}
